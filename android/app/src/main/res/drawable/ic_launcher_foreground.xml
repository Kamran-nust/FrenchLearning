<!-- App icon foreground: the French-style crossed 7 (NCLC 7) in gold, inside a progress ring drawn in the
     French flag's blue, white and red. The midnight-navy background is the adaptive icon's background layer.
     108x108 viewport; everything stays inside the ~66dp safe zone so no launcher mask clips it.
     Same geometry as android/store/icon.svg (the 512x512 Play Store listing icon). -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- progress ring, three flag-coloured segments -->
    <path android:pathData="M54,26 A28,28 0 0 1 81.93,55.95"
        android:strokeColor="#3B82F6" android:strokeWidth="4.5" android:strokeLineCap="round" />
    <path android:pathData="M80.92,61.72 A28,28 0 0 1 47.23,81.17"
        android:strokeColor="#EDE7DA" android:strokeWidth="4.5" android:strokeLineCap="round" />
    <path android:pathData="M41.73,79.17 A28,28 0 0 1 29.75,40"
        android:strokeColor="#E5484D" android:strokeWidth="4.5" android:strokeLineCap="round" />
    <!-- the 7 -->
    <path android:pathData="M43,41 H65 L51,69"
        android:strokeColor="#F5B841" android:strokeWidth="6.5"
        android:strokeLineCap="round" android:strokeLineJoin="round" />
    <!-- the French cross-bar -->
    <path android:pathData="M50.5,55.5 H64"
        android:strokeColor="#EDE7DA" android:strokeWidth="5" android:strokeLineCap="round" />
</vector>
