# Copy this file to  keystore.properties  (same folder, which is gitignored) and fill in your own
# values. NEVER commit keystore.properties or the .jks file - they sign your app and must stay secret.
#
# Generate the keystore once (keep the file and these passwords backed up somewhere safe - if you
# lose them you can't update the app on Play):
#
#   keytool -genkey -v -keystore french-nclc7-release.jks -keyalg RSA -keysize 2048 \
#           -validity 10000 -alias french-nclc7
#
# storeFile is the path to that .jks, relative to the android/ folder (or an absolute path).

storeFile=french-nclc7-release.jks
storePassword=CHANGE_ME
keyAlias=french-nclc7
keyPassword=CHANGE_ME
